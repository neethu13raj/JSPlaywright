pipeline {
    agent any

    environment {
        PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = '1' // Optional: Skip auto-download
        HOME = "${env.WORKSPACE}"
    }

    tools {
        nodejs 'node-18' // Make sure Node.js is configured in Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                // Replace with your Git repo if needed
                git url: 'https://github.com/your-username/your-playwright-repo.git', branch: 'main'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci' // or 'npm install'
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                sh 'npx playwright install --with-deps'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'npx playwright test'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
        }

        success {
            echo 'Tests completed successfully!'
        }

        failure {
            echo 'Tests failed.'
        }
    }
}